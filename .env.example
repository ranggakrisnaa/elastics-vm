# Copy to .env (git-ignored) and fill in. Empty = compose default.
# Generate secrets: openssl rand -hex 32  (also store in Secret Manager, see docs/elastic-access.md)

# --- Secrets (required on the shared VM) ---
APM_SECRET_TOKEN=
REDIS_PASSWORD=

# --- Redis ---
REDIS_MAXMEMORY=512mb
# noeviction = reject writes when full (safe for data); allkeys-lru = pure cache
REDIS_EVICTION=noeviction

# --- App / APM agent ---
# IMAGE=asia-southeast2-docker.pkg.dev/common-cicd-dev-01/gc-bribrain-dev-gar-docker-01/apm-elastics:latest
# VERSION=dev
# APM_SERVER_URL=http://apm-server:8200
# SERVICE_NAME=apm-elastics
# APM_ENV=development
# APM_SAMPLE_RATE=1.0
# TEAM=platform

# --- Elastic stack ---
# ELASTIC_VERSION=9.2.0
